# indesign-nutria-mcp configuration
#
# Copy this file to .env and customize.
# All settings have defaults — no env vars are required.

# --- Bridge (WebSocket to InDesign UXP plugin) ---
BRIDGE_PORT=8120
BRIDGE_HOST=127.0.0.1
BRIDGE_MAX_PAYLOAD=1048576
BRIDGE_TIMEOUT=30000

# --- HTTP Bridge (optional REST fallback) ---
HTTP_BRIDGE_ENABLED=false
HTTP_BRIDGE_PORT=3000
HTTP_BRIDGE_HOST=127.0.0.1
BRIDGE_TOKEN=

# --- Server ---
SERVER_TRANSPORT=stdio
SERVER_NAME=indesign-nutria-mcp
SERVER_VERSION=1.0.0

# --- Windows COM bridge (opt-in alternative to the UXP plugin) ---
# Requires InDesign running on Windows; drives it via cscript + DoScript.
COM_BRIDGE_ENABLED=false
# COM_BRIDGE_CSCRIPT_PATH=cscript
# COM_BRIDGE_VBS_PATH=assets/windows/run_jsx_persistent.vbs

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# Overrides LOG_LEVEL unconditionally (useful for troubleshooting)
LOG_LEVEL_OVERRIDE=
