{
  "name": "indesign-nutria-mcp",
  "version": "1.6.1",
  "mcpName": "io.github.nutriandrea/indesign-nutria-mcp",
  "description": "The most comprehensive MCP server for Adobe InDesign: 199 tools, AI-native, full DOM control",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "indesign-nutria-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "plugin/",
    "skills/",
    "docs/",
    "media/",
    "bridge-proxy.mjs",
    "jxa-driver.js",
    "start-bridge.sh",
    "indesign-nutria-mcp.json",
    "opencode.json",
    "opencode-indesign.json",
    "server.json",
    "llms.txt",
    "examples/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "WINDOWS.md",
    ".env.example"
  ],
  "homepage": "https://github.com/nutriandrea/adobe-indesign-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nutriandrea/adobe-indesign-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nutriandrea/adobe-indesign-mcp/issues"
  },
  "keywords": [
    "adobe",
    "indesign",
    "mcp",
    "model-context-protocol",
    "ai",
    "automation",
    "claude",
    "opencode",
    "extendscript",
    "uxp",
    "design-automation",
    "publishing",
    "print",
    "layout"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "lint": "eslint src scripts --ext .ts",
    "lint:fix": "eslint src scripts --ext .ts --fix",
    "verify:tool-counts": "tsx scripts/verify-tool-counts.ts",
    "verify:tool-names": "tsx scripts/verify-tool-names.ts",
    "docs:tools": "tsx scripts/generate-tool-docs.ts",
    "verify:docs": "tsx scripts/generate-tool-docs.ts --check",
    "server:json": "tsx scripts/generate-server-json.ts",
    "verify:server-json": "tsx scripts/generate-server-json.ts --check",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "build:agensi": "node scripts/build-agensi.mjs",
    "validate:release-tag": "bash scripts/validate-release-tag.sh",
    "verify:pack": "npm run build && node scripts/verify-pack.mjs",
    "verify": "npm run lint && npm run verify:tool-counts && npm run verify:tool-names && npm run verify:docs && npm run verify:server-json && npm test",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "smoke:target": "node scripts/smoke-document-target.mjs",
    "smoke:recipes": "node scripts/smoke-recipes.mjs",
    "smoke:dom": "node scripts/smoke-dom-contracts.mjs",
    "prepublishOnly": "npm run verify && npm run verify:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "uuid": "^14.0.3",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
